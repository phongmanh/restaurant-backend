<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} [%X{request_id}] - %msg%n</pattern>
        </encoder>
    </appender>
    <!-- As in logback.xml: Exposed's WARN lines quote statement parameters. -->
    <logger name="Exposed" level="ERROR"/>
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
