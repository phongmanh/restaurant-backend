# syntax=docker/dockerfile:1

# The service's image for Vercel's container runtime (architecture §8, ADR-0002). Vercel accepts only
# this file name as a container entrypoint. Plain JVM, as S-1 measured it; S-1's AOT cache took
# about 1 s off a 5-7 s cold start, most of which is the platform's.
#
# Both base images are pinned by digest: Vercel builds the image once per project, so staging and
# production get identical layers only from a fixed digest (release-checklist P-2). Dependabot's
# weekly `docker` PR moves the digests to the patched images.

FROM eclipse-temurin:25-jdk@sha256:2d5d5e9b533342a565907c84f47a2ec298c40cde7b13a3ca85d4950fa456a641 AS build
WORKDIR /workspace

COPY gradlew settings.gradle.kts build.gradle.kts ./
COPY gradle/ gradle/
RUN ./gradlew --no-daemon --quiet --version

COPY src/main/ src/main/
RUN ./gradlew --no-daemon --quiet buildFatJar \
    && cp build/libs/*-all.jar /workspace/app.jar

FROM eclipse-temurin:25-jre@sha256:ecdc0adb37bde1a281c4d245a3cd535004b1fc8322d560f5b09463b248c81df0 AS runtime
# The Ubuntu base ships Canonical's Pebble (`/usr/bin/pebble`, a Go service manager, no dpkg
# package); the service never runs it, and its Go runtime carries advisories CI's Grype check
# fails on (deploy/README.md "Vulnerable dependencies").
RUN rm -f /usr/bin/pebble \
    && groupadd --system app && useradd --system --gid app --home /app app
WORKDIR /app
COPY --from=build --chown=app:app /workspace/app.jar /app/app.jar
COPY --chown=app:app docker-entrypoint.vercel.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh
USER app

# Vercel routes to $PORT (default 80, which a non-root process can't bind): the project sets PORT=8080.
EXPOSE 8080
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["java", "-XX:+UseG1GC", "-XX:MaxRAMPercentage=75.0", "-jar", "/app/app.jar"]
