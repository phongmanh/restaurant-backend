# Production's settings that aren't secret (release-checklist §4, deploy/README.md). push-env.sh sends
# them with the secrets in .env.production. Release 1's production holds test data only. Its public
# domain restaurant-production.vercel.app stays up for the client apps (Q-29); every other domain keeps
# Deployment Protection.
APP_ENV=production
PORT=8080
# The tokens' issuer: a fixed name, since each deploy's URL differs (CR-011).
AUTH_ISSUER=https://restaurant-production.vercel.app
# The staff and admin web apps reach the API through their own /api rewrite (core-and-auth §16 Q2), so
# the browser keeps the refresh cookie under /api/v1/auth. A client calling /v1/auth/refresh on the API
# directly doesn't send the cookie back (Q-29).
AUTH_COOKIE_PATH=/api/v1/auth
# Where invitation, reset and QR links point; production needs https. Placeholders until each app's
# first deploy shows its real domain (Vercel may add a suffix): take it from `vercel alias ls` (Q-29).
STAFF_APP_URL=https://restaurant-staff-web.vercel.app
ADMIN_APP_URL=https://admin.production.example
CUSTOMER_APP_URL=https://order.production.example
# CORS: every web app's origin, comma-separated. The staff and admin apps' /api rewrite forwards the
# browser's Origin header, so they need an entry too; an unlisted origin gets a bare 403 (CR-016).
ALLOWED_ORIGINS=https://restaurant-staff-web.vercel.app
# Release 1 has no live push (CR-013): screens poll the event log.
LIVE_PUSH=off
