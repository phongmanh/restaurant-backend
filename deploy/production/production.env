# Production's settings that aren't secret (release-checklist §4, deploy/README.md). push-env.sh sends
# them with the secrets in .env.production. Release 1's production holds test data only (Q-24: no
# public domain, Deployment Protection on).
APP_ENV=production
PORT=8080
# The tokens' issuer: a fixed name, since each deploy's URL differs (CR-011).
AUTH_ISSUER=https://restaurant-production.vercel.app
# No web app rewrites /api in front of the API yet, so the refresh cookie's path is the API's own.
AUTH_COOKIE_PATH=/v1/auth
# Where invitation, reset and QR links point. No client app exists yet; production needs https.
STAFF_APP_URL=https://staff.production.example
ADMIN_APP_URL=https://admin.production.example
CUSTOMER_APP_URL=https://order.production.example
# Release 1 has no live push (CR-013): screens poll the event log.
LIVE_PUSH=off
