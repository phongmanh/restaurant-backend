# Staging's settings that aren't secret (deploy/README.md). push-env.sh sends them with the secrets.
APP_ENV=staging
PORT=8080
# The tokens' issuer: a fixed name, since each deploy's URL differs (CR-011).
AUTH_ISSUER=https://restaurant-staging.vercel.app
# No web app rewrites /api in front of staging, so the refresh cookie's path is the API's own.
AUTH_COOKIE_PATH=/v1/auth
# Where invitation, reset and QR links point. No client app exists yet; the system tests read the
# token from the link's fragment.
STAFF_APP_URL=https://staff.staging.example
ADMIN_APP_URL=https://admin.staging.example
CUSTOMER_APP_URL=https://order.staging.example
# Release 1 has no live push (CR-013): screens poll the event log. "ably" needs ABLY_API_KEY in .env.staging.
LIVE_PUSH=off
